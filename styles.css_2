@import url('https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Heebo', sans-serif;
}

body {
    width: 100%;
    margin: 0 auto;
}




.container {
    padding-top: 50px;
    display: flex;
   
    align-items: center;
    width: 100%;    
    justify-content: center;
}

.container .card {
    width: 50%;
}


.container .card p {
    width: 85%;
    font-size: 17px;
    margin: 25px 0;
    color: gray;
}

.container .card button {
    padding: 12px 22px;
    font-size: 10px;
    border: none;
    outline: none;
    border-radius: 8px;
    background: blueviolet;
    color: white;
    cursor: pointer;
    transition: 0.5s;
}

.container .card button:hover {
    background: rgb(81, 18, 255);
    scale: 1.2;
}

.container .photo img {
    width: 520px;
}

